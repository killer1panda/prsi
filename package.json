{
  "name": "doom-index-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@10.9.8",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "turbo": "^2.1.0",
    "uuid": "^11.1.1"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "tar": "^6.2.1",
    "semver": "^7.5.2",
    "send": "^0.19.0",
    "body-parser": "^1.20.3",
    "qs": "^6.13.0",
    "@xmldom/xmldom": "^0.8.10",
    "xml2js": "^0.6.2",
    "image-size": "^0.9.3"
  }
}
